# mailFlow — configuration locale
# Copier en `.env` et remplir. Ce fichier n'est JAMAIS commité.

PORT=4100

# Plafond, en Mo, du cache des mails ouverts (corps + pièces jointes sur disque).
# Au-delà, les mails ouverts le moins récemment sont retirés ; ils se
# retéléchargent à la réouverture. 500 par défaut, 50 au minimum.
# CACHE_MAX_MB=500

# Dossier des données (cache SQLite, jetons, comptes ajoutés depuis l'interface).
# server/data par défaut. L'application Windows empaquetée le place elle-même
# dans %APPDATA%\mailFlow\data.
# MAILFLOW_DATA_DIR=

# ── Comptes ajoutés depuis l'interface ───────────────────────────────────────
# Le bouton « Comptes » de la barre du haut ajoute une boîte sans passer par ce
# fichier : elle est enregistrée dans server/data/accounts.json, mot de passe
# chiffré (AES-256-GCM). Clé : MAILFLOW_SECRET_KEY (32 octets en base64) si
# renseignée, sinon server/data/secret.key, créée au premier ajout.
# Avec MAILFLOW_SECRET_KEY, les jetons OAuth (tokens.json) sont chiffrés eux
# aussi. La perdre ou la changer rend illisible tout ce qu'elle a chiffré.
# MAILFLOW_SECRET_KEY=

# Réservé à l'application Windows empaquetée, qui le tire au hasard à chaque
# lancement : quand il est défini, le serveur refuse toute requête qui ne porte
# pas ce jeton en cookie. À ne pas renseigner ici.
# MAILFLOW_SESSION_TOKEN=
#
# Applications OAuth proposées par défaut au formulaire d'ajout. Sans
# MS_OAUTH_CLIENT_ID, l'identifiant du premier compte Microsoft ci-dessous sert.
# Google : ID client OAuth de type « Application Web » (docs/accounts.md).
# L'identifiant Microsoft retenu ici est aussi celui que `npm run desktop:dist`
# inscrit dans l'application Windows : ses utilisateurs n'ont rien à déclarer.
# Rien d'autre de ce fichier ne part dans l'application.
# MS_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Chaque compte se déclare avec un index : MAIL_1_*, MAIL_2_*, etc.
# `MAIL_1_ID` doit être un slug stable : il sert de clé en base et dans les URL.
#
# `MAIL_x_AUTH` vaut « password » (IMAP classique) ou « oauth2 ».
# Outlook.com a coupé l'authentification basique le 16/09/2024 : les mots de passe
# d'application y sont refusés, oauth2 est le seul mode qui fonctionne.

# ── Compte OAuth2 (Outlook.com / Microsoft 365) ──────────────────────────────
# Le client ID vient d'une inscription d'application Microsoft Entra, en client
# public, avec l'URI de redirection http://localhost:4100/api/oauth/callback
MAIL_1_ID=outlook
# Surnom dans la barre latérale uniquement. Ce n'est pas le nom vu par les destinataires.
MAIL_1_LABEL=Perso
# Nom inscrit dans l'en-tête From. Laisser vide pour n'envoyer que l'adresse.
# MAIL_1_FROM_NAME=Prénom Nom
MAIL_1_EMAIL=prenom.nom@outlook.fr
MAIL_1_AUTH=oauth2
MAIL_1_OAUTH_CLIENT_ID=
MAIL_1_OAUTH_TENANT=consumers
# « microsoft » par défaut. « google » pour Gmail, avec MAIL_1_OAUTH_CLIENT_SECRET.
# MAIL_1_OAUTH_PROVIDER=microsoft
MAIL_1_IMAP_HOST=outlook.office365.com
MAIL_1_IMAP_PORT=993
MAIL_1_IMAP_SECURE=true
MAIL_1_SMTP_HOST=smtp-mail.outlook.com
MAIL_1_SMTP_PORT=587
MAIL_1_SMTP_SECURE=false
MAIL_1_USER=prenom.nom@outlook.fr

# ── Compte IMAP classique (o2switch, Hostinger…) ─────────────────────────────
# MAIL_2_ID=pro
# MAIL_2_LABEL=Pro
# MAIL_2_EMAIL=contact@example.com
# MAIL_2_AUTH=password
# MAIL_2_IMAP_HOST=mail.example.com
# MAIL_2_IMAP_PORT=993
# MAIL_2_IMAP_SECURE=true
# MAIL_2_SMTP_HOST=mail.example.com
# MAIL_2_SMTP_PORT=465
# MAIL_2_SMTP_SECURE=true
# MAIL_2_USER=contact@example.com
# MAIL_2_PASS=
